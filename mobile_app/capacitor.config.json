{
  "appId": "com.bantubuzz.app",
  "appName": "BantuBuzz",
  "webDir": "../frontend/dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#f7f9f6",
      "androidScaleType": "CENTER",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f7f9f6",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "light",
      "resizeOnFullScreen": true
    }
  }
}
